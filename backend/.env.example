# Environment Configuration
ENV=development

# IBM Verify Configuration
IBM_VERIFY_TENANT_URL=https://cds-gcsignin-dev.verify.ibm.com/
IBM_VERIFY_MIGRATION_API_CLIENT_ID=your-migration-api-client-id
IBM_VERIFY_MIGRATION_CLIENT_ID=your-migration-client-id
IBM_VERIFY_MIGRATION_SECRET=your-migration-secret
IBM_VERIFY_MIGRATION_API_SECRET=your-migration-api-secret

# Logging, for LOCAL DEBUGGING, set it to LOG_LEVEL=DEBUG
LOG_LEVEL=INFO

# Legacy Configuration (Deprecated - no longer used)
# MIGRATION_RP_CONFIG_PATH=/app/migration_rp.json

# RP Configuration (Relying Party)
# These values were previously stored in migration_rp.json
RP_CLIENT_ID=your-rp-client-id
RP_CLIENT_NAME=your-rp-client-name
RP_CLIENT_NAME_EN=Your RP Client Name (English)
RP_CLIENT_NAME_FR=Your RP Client Name (French)
RP_REDIRECT_URI=http://localhost:8080/auth/callback/client1
RP_REDIRECT_URI_EN=http://localhost:8080/auth/callback/client1
RP_REDIRECT_URI_FR=http://localhost:8080/auth/callback/client1

# Legacy IDP Configuration (Indexed format - supports multiple IDPs)
# These values were previously stored in migration_rp.json under the IDP array
# Use indexed variables to define multiple IDPs: 0, 1, 2, etc.

# First IDP (index 0)
LEGACY_IDP_0_CLIENT_ID=your-idp-client-id
LEGACY_IDP_0_CLIENT_NAME=SIC
LEGACY_IDP_0_CLIENT_SECRET=your-client-secret
LEGACY_IDP_0_OPENID_CONFIGURATION=https://your-idp.example.com/.well-known/openid-configuration
LEGACY_IDP_0_REDIRECT_URIS=http://localhost:8000/v1/auth/legacy/callback
LEGACY_IDP_0_SCOPE=openid profile email
LEGACY_IDP_0_MAX_AGE=3600
LEGACY_IDP_0_CODE_CHALLENGE_METHOD=S256

# Second IDP (index 1) - Optional, add as many as needed
# LEGACY_IDP_1_CLIENT_ID=another-idp-client-id
# LEGACY_IDP_1_CLIENT_NAME=Another IDP
# LEGACY_IDP_1_CLIENT_SECRET=another-client-secret
# LEGACY_IDP_1_OPENID_CONFIGURATION=https://another-idp.example.com/.well-known/openid-configuration
# LEGACY_IDP_1_REDIRECT_URIS=http://localhost:8000/v1/auth/legacy/callback2,http://localhost:8000/v1/auth/legacy/callback3
# LEGACY_IDP_1_SCOPE=openid profile
# LEGACY_IDP_1_MAX_AGE=7200
# LEGACY_IDP_1_CODE_CHALLENGE_METHOD=S256

# Note: Multiple redirect URIs can be comma-separated in REDIRECT_URIS
# Note: Continue with LEGACY_IDP_2_*, LEGACY_IDP_3_*, etc. for additional IDPs
