  "info": {
    "contact": {
      "email": "gcsignin@cds-snc.ca",
      "name": "GC Sign In Team",
      "url": "https://github.com/cds-snc/gc-signin-user-self-service-webapp"
    },
    "description": "\nThis API backend service primarily interacts with [IBM Verify service](https://docs.verify.ibm.com/verify/reference).\nAPI endpoints are consumed by our frontend application to perform user authentication and profile management.\nThe API endpoints enable our custom frontend application to implement complex workflows and user interfaces without limitations.\n\n### Features\n\n* Password-based authentication\n* SMS, Email, Voice callback one-time passcode (OTP)\n",
    "title": "GC Sign In Backend API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns the health status of the service",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
