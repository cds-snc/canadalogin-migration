IDP_USER_EMAIL=gckey.user@example.com
IDP_USER_CUSTOM_ATTRIBUTES={"legacy_provider":"GCKey","credential_service_provider":"GCKey","loa":"urn:gc-ca:cyber-auth:assurance:loa2","credential_type":"GCKey"}
