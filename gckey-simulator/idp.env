IDP_ENTITY_ID=local-gckey-saml-idp
IDP_AUTH_MODE=auto
IDP_NAMEID_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
IDP_NAMEID_ATTRIBUTE=uid
IDP_USER_NAME=gckey-user
IDP_USER_PASSWORD=gckey-password
